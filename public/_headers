# Cloudflare Pages headers. Not applied by `vite preview`; live only on Pages.
# One path per block: Cloudflare attaches a header block only to the last path
# listed before it, so paths are never grouped. Every path gets its own block.

# Hashed build output never changes content, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Terrain grids, maps and textures are large and change only with a new build.
/moon-elevation.f32
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/illumination-map.u8
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/moon-polar-dem-north.i16
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/moon-polar-dem-south.i16
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/moon-polar-light-north.u8
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/moon-polar-light-south.u8
  Cache-Control: public, max-age=604800
  Content-Type: application/octet-stream

/moon-terrain-4k.jpg
  Cache-Control: public, max-age=604800

/moon-8k.jpg
  Cache-Control: public, max-age=604800

/moon.jpg
  Cache-Control: public, max-age=604800

/earth-day.jpg
  Cache-Control: public, max-age=604800

/earth-night.jpg
  Cache-Control: public, max-age=604800

/lumbra-logo.svg
  Cache-Control: public, max-age=604800

# Documents stay revalidated.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
